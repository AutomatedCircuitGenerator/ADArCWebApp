@using System.Text
@inject BoardService BoardService
<div class="canvas-container" style="--connection-display: @(ShowBreadboard ? "none" : "inline");" @onmousemove="DragMiddle" @onclick="CanvasClick" @onmousedown="DragStart" @onmouseup="DragEnd" @onwheel="UpdZoom" @onmouseenter="handleMouseEnter" @onmouseleave="() => { _dragging = false; handleMouseLeave.InvokeAsync(); foreach (var component in _componentReferences.Values) { component.EndEnvSettingsDrag(); } }">
    @if (ShowBreadboard)
    {
        <Breadboard BreadboardRot="BreadboardRot" Transform="transform" zoomFactor="@zoomFactor" zoomedX=@BreadboardZoomX CanvasClick="CanvasClick" zoomedY=@BreadboardZoomY DragStart="e => DragBreadboardStart(e)" DragEnd="DragComponentEnd" forceBorder="-3 == Pages.Index.App!.SelectedComponent" handleClick="BreadboardSelection"/>
        <div class="right-click-container" style="top: @(BreadboardZoomX)px; left: @(BreadboardZoomY)px">
            <button id="component-help-button" >
                <span style="padding-left: 3px">𝗶</span>
                <span style="padding-left: 7px">￨ Component Information</span>
            </button>
        </div>
    }
    @if (BoardService.Board != Board.None)
    {
        <div class="zoom-control">
            <button class="zoom-btn" @onclick="ZoomOut">−</button>
            <span class="zoom-perc"> @ZoomPercent%</span>
            <button class="zoom-btn" @onclick="ZoomIn">+</button>
            <button class="reset-btn" @onclick="ResetZoom">Reset</button>
        </div>
    }
    @{
        double CurrentOffset = 0;
    }
    @foreach (var c in comps)
    {
        if (c.Value.Data.LivesOnBreadBoard)
        {
            <VaryingComponent Transform="transform" @ref="_componentReferences[c.Value.localId]"
                              CanvasClick="CanvasClick" CancelDrag="CancelDrag"
                              forceBorder="c.Key == Pages.Index.App!.SelectedComponent"
                              handleClick="e => ComponentSelection(e, c)" objId=@(c.Value.GlobalId)
                              BreadBoard_X="@(ShowBreadboard ? BreadboardZoomX + CurrentOffset * zoomFactor + c.Value.Data.BreadboardOffsetX * zoomFactor : c.Value.zoomedX)"
                              BreadBoard_Y="@(ShowBreadboard ? BreadboardZoomY + c.Value.Data.BreadboardOffsetY * zoomFactor : c.Value.zoomedY)" 
                              individualData=@c.Value DragStart="e => DragComponentStart(e, c)"
                              DragEnd="DragComponentEnd" zoomFactor="@zoomFactor"></VaryingComponent>

            CurrentOffset += c.Value.Data.Width;
        }
        else
        {
            <VaryingComponent Transform="transform" @ref="_componentReferences[c.Value.localId]" CanvasClick="CanvasClick" CancelDrag="CancelDrag" forceBorder="c.Key == Pages.Index.App!.SelectedComponent" handleClick="e => ComponentSelection(e, c)" objId=@(c.Value.GlobalId) individualData=@c.Value DragStart="e => DragComponentStart(e, c)" DragEnd="DragComponentEnd" zoomFactor="@zoomFactor"></VaryingComponent>
        }
    }
    <svg viewBox="0 0 @(Pages.Index.DefaultScreenWidth * Pages.Index.CurrentWidthRatio) @(Pages.Index.DefaultScreenHeight * Pages.Index.CurrentHeightRatio - 50)" xmlns="http://www.w3.org/2000/svg">
        @foreach (var line in GetAllGridLines(ConnLines))
        {
            var highlighted = _target.Value?.localId == line.FromId && line.FromId == Pages.Index.App!.SelectedComponent;
            <circle class="node @(highlighted ? "highlighted" : "")" cx="@line.Segments.First().x1" cy="@line.Segments.First().y1" r="@(3 * zoomFactor)" fill="@line.Color"></circle>
            <path d="@BuildPathData(line.Segments)"
                  stroke="@line.Color"
                  stroke-width="@(3 * zoomFactor)"
                  fill="none"
                  stroke-linejoin="round"
                  class="segment @(highlighted ? "highlighted" : "")"
                  style="--glow:@line.Color">
                <title>@line.Tooltip</title>
            </path>
            <circle class="node @(highlighted ? "highlighted" : "")" cx="@line.Segments.Last().x2" cy="@line.Segments.Last().y2" r="@(3 * zoomFactor)" fill="@line.Color"></circle>
        }
    </svg>


</div>

@code {
    
    [Parameter]
    public bool ShowBreadboard { get; set; }

    public int BreadboardRot;
    public MainCanvas()
    {
        Pages.Index.BuildCanvas = this;
    }

    public readonly List<InstanceConnection> ConnLines = [];

    [Parameter] public required Dictionary<int, ComponentInstance> comps { get; set; }

    private Dictionary<int, VaryingComponent> _componentReferences = new();

    protected override void OnParametersSet()
    {
        // Remove references that no longer exist in comps
        var keysToRemove = _componentReferences.Keys.Except(comps.Keys).ToList();
        foreach (var key in keysToRemove)
        {
            _componentReferences.Remove(key);
        }
    }

    [Parameter] public EventCallback<MouseEventArgs> handleMouseLeave { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> handleMouseEnter { get; set; }


    private bool _dragging = false;
    private bool _hasTarget = false; //refers to whether or not a drag process has a target, meaning that a component is dragged
    private bool _breadboardDrag = false;
    private KeyValuePair<int, ComponentInstance> _target;

    private Transform transform = new();

    /// <summary>
    /// Transform refers to the combination of fullscreen drag and zoom.
    /// This function resets both.
    /// </summary>
    public void ResetTransform()
    {
        transform = new Transform();
        AdjustZoom();
    }

    private void CancelDrag()
    {
        _dragging = false;
    }

    private (double x, double y) zoomOrigin = (950 / 2, 1080 / 2); //assumes 1920x1080, doesn't really matter, but shouldn't change

    //compatibility property to reference into the transform without refactoring everything
    public double zoomFactor
    {
        get { return transform.scale; }
        set { transform.scale = value; }
    }

    private record Segment(double x1, double y1, double x2, double y2);

    private record GridLine(string Color, 
        (double x, double y) Start, 
        (double x, double y) End, 
        int FromId, 
        int ToId, 
        string Tooltip,
        List<Segment> Segments);
    
    private string BuildPathData(List<Segment> segments, double cornerRadius = 10)
    {
        if (segments.Count == 0) return "";

        var path = new StringBuilder();
        path.Append($"M {segments[0].x1} {segments[0].y1} "); 

        for (int i = 0; i < segments.Count - 1; i++)
        {
            var current = segments[i];
            var next = segments[i + 1];

            var dx1 = current.x2 - current.x1;
            var dy1 = current.y2 - current.y1;
            var dx2 = next.x2 - next.x1;
            var dy2 = next.y2 - next.y1;

            var isStraight = (dx1 * dy2 == dx2 * dy1); 

            if (isStraight)
            {
                path.Append($"L {current.x2} {current.y2} ");
                continue;
            }

            var len1 = Math.Sqrt(dx1 * dx1 + dy1 * dy1);
            var len2 = Math.Sqrt(dx2 * dx2 + dy2 * dy2);

            var trim1 = Math.Min(cornerRadius, len1 / 2);
            var trim2 = Math.Min(cornerRadius, len2 / 2);

            var newX1 = current.x2 - (dx1 / len1) * trim1;
            var newY1 = current.y2 - (dy1 / len1) * trim1;
            var newX2 = next.x1 + (dx2 / len2) * trim2;
            var newY2 = next.y1 + (dy2 / len2) * trim2;

            path.Append($"L {newX1} {newY1} ");

            path.Append($"Q {current.x2} {current.y2}, {newX2} {newY2} ");
        }

        var lastSegment = segments.Last();
        path.Append($"L {lastSegment.x2} {lastSegment.y2} ");

        return path.ToString();
    }
    
    /// <summary>
    /// Computes all the gridlines for the given connections
    /// </summary>
    /// <param name="connections"></param>
    /// <returns></returns>
    private List<GridLine> GetAllGridLines(List<InstanceConnection> connections)
    {
        // Maps a given gridline's (From ID, Starting X) to whether to route horizontally first
        Dictionary<(int, int), (bool, bool)> routes = new();
        var lines = new List<GridLine>();

        if (ShowBreadboard)
        {
            GetAllGridLines_BreadboardPresent(lines, connections, routes);
        }
        else
        {
            GetAllGridLines_NoBreadboardPresent(lines, connections, routes);
        }
        
        for (var i = 0; i < lines.Count; i++)
        {
            var line = lines[i];
            GetGridSegments(line, 4 + i * 8, routes[(line.FromId, (int)Math.Floor(line.Start.x))]);
        }

        return lines;
    }

    private void GetAllGridLines_NoBreadboardPresent(List<GridLine> lines, List<InstanceConnection> connections, Dictionary<(int, int), (bool, bool)> routes)
    {
        foreach (var connection in connections)
        {
            var toPin = connection.To.Data.pinInfo[connection.ToId];
            var fromPin = connection.From.Data.pinInfo[connection.FromId];
            var startRot = connection.From.rotation;
            var start = ZoomCoord((connection.From.X + RotateX(startRot, fromPin.x, fromPin.y), connection.From.Y + RotateY(startRot, fromPin.x, fromPin.y)));
            var endRot = connection.To.rotation;
            var end = ZoomCoord((connection.To.X + RotateX(endRot, toPin.x, toPin.y), connection.To.Y + RotateY(endRot, toPin.x, toPin.y)));
            var tooltip = $"{connection.From.Data.name} {fromPin.name} → " +
                          $"{connection.To.Data.name} {toPin.name}";
            lines.Add(new GridLine(connection.Color, 
                start, 
                end, 
                connection.From.localId, 
                connection.To.localId, 
                tooltip,
                []));

            // If there exists another gridline on the same X axis, we must route horizontally first to prevent overlap
            RouteWire(routes, start.x, connection.From.localId);
        }
    }

    private void GetAllGridLines_BreadboardPresent(List<GridLine> lines, List<InstanceConnection> connections, Dictionary<(int, int), (bool, bool)> routes)
    {
        // Holes already assigned to component wires
        var usedHoles = comps.Values
            .SelectMany(c => c.BreadboardConnections)
            .Select(c => c.HoleId)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        // Get all positive power rail holes
        var positiveHoles = Enumerable.Range(1, 25)
            .Select(i => $"LPLUS_{i}")
        .ToList();

        // Get all negative power rail holes
        var negativeHoles = Enumerable.Range(1, 25)
        .Select(i => $"LMINUS_{i}")
        .ToList();        
        
        // All possible breadboard holes
        var availableHoles = (
                from row in Enumerable.Range(1, 30)
                from column in "abcdefghij"
                select $"{column}{row}"
            )
            .Concat(positiveHoles)
            .Concat(negativeHoles)
            .ToList();

        // Prevent duplicate Arduino wires on the same net
        var drawnArduinoWires = new HashSet<(int, int, string)>();
        
        foreach (var comp in comps.Values)
        {
            foreach (var connection in comp.BreadboardConnections)
            {
                var originalWire = connections.FirstOrDefault(c => (c.From.localId == comp.localId && c.FromId == connection.FromPinId) || (c.To.localId == comp.localId && c.ToId == connection.FromPinId)); // Searching for original connection for this pin
                var wireColor = originalWire?.Color ?? connection.Color; // Find original wire color to make connections more consistent

                if(!comp.Data.LivesOnBreadBoard){
                    //Add Wire from component to Breadboard
                    var pin = comp.Data.pinInfo[connection.FromPinId]; // Find the component pin position
                    var (holeX, holeY) = BreadboardHoleCoordinates.GetCenter(connection.HoleId); // Find the breadboard hole center
                    var compRot = comp.rotation;
                    var start = ZoomCoord((comp.X + RotateX(compRot, pin.x, pin.y), comp.Y + RotateY(compRot, pin.x, pin.y))); // Wire starting point at component pin
                    var end = ZoomCoord((BreadboardX + holeX, BreadboardY + holeY)); // Wire ending point at breadboard hole
                    lines.Add(new GridLine(
                        wireColor,
                        start,
                        end,
                        comp.localId,
                        -1,
                        $"{comp.Data.name} {pin.name} → Breadboard {connection.HoleId}",
                        []
                    ));
                    RouteWire(routes, start.x, comp.localId);
                }

                if (originalWire == null) continue; //no connection to arduino i guess??? This causes a floating line
                
                var candidates = comp.Data.pinInfo[connection.FromPinId].name.Trim().ToUpperInvariant() switch
                {
                    "VCC" or "VDD" or "5V" or "VIN" => positiveHoles,
                    "GND" or "VSS" or "GROUND" or "CATHODE" or "COM" or "PWR_GND" or "BROWN" => negativeHoles,
                    _ => null
                };
                string? BreadboardPowerPin = null;
                
                if(comp.Data.LivesOnBreadBoard && candidates != null){
                    //Wire from Lives on breadboard component to powerlines
                    var pin = comp.Data.pinInfo[connection.FromPinId]; // Find the component pin position
                    
                    var BreadboardComponentPin = availableHoles.FirstOrDefault(h => !usedHoles.Contains(h) && BreadboardNet.AreConnected(h, connection.HoleId), null);
                    if(BreadboardComponentPin == null)continue;
                    var (holeX, holeY) = BreadboardHoleCoordinates.GetCenter(BreadboardComponentPin); // Find the breadboard hole center

                    BreadboardPowerPin = candidates.FirstOrDefault
                        (h => !usedHoles.Contains(h) && h != candidates[0], null);
                    if(BreadboardPowerPin == null)continue;
                    var (PholeX, PholeY) = BreadboardHoleCoordinates.GetCenter(BreadboardPowerPin); // Find the breadboard hole center
                    
                    Console.WriteLine("Orininal Pin: {0}, New Pin: {1}, PowerPin: {2}", connection.HoleId, BreadboardComponentPin, BreadboardPowerPin);
                    var start = ZoomCoord((BreadboardX + PholeX, BreadboardY + PholeY)); // Wire ending point at breadboard hole
                    var end = ZoomCoord((BreadboardX + holeX, BreadboardY + holeY)); // Wire ending point at breadboard hole
                    lines.Add(new GridLine(
                        wireColor,
                        start,
                        end,
                        comp.localId,
                        -1,
                        $"{comp.Data.name} {pin.name} → Breadboard {connection.HoleId}",
                        []
                    ));
                    usedHoles.Add(BreadboardComponentPin);
                    usedHoles.Add(BreadboardPowerPin);
                    RouteWire(routes, start.x, comp.localId);
                    
                }
                
                
                {
                    //Wire from arduino to breadboard!
                    var holeId = BreadboardPowerPin == null ? connection.HoleId : BreadboardPowerPin;
                    bool compIsFrom = originalWire.From.localId == comp.localId; // Check if first pin of the connection is the component
                    var arduino = compIsFrom ? originalWire.To : originalWire.From; // Store Arduino
                    var arduinoPinId = compIsFrom ? originalWire.ToId : originalWire.FromId; // Store pin ID of Arduino of the current connection
                    var arduinoPin = arduino.Data.pinInfo[arduinoPinId]; // Store the Arduino pin of the current connection
                    var arduinoStart = ZoomCoord((arduino.X + RotateX(arduino.rotation, arduinoPin.x, arduinoPin.y), arduino.Y + RotateY(arduino.rotation, arduinoPin.x, arduinoPin.y))); // Calculate Arduino pin's position on the workbench
                    string netId = BreadboardNet.GetNetId(holeId); // Get the breadboard hole group of the current connection, i.e. a1, b1, c1, d1, e1 are in the same group,...
                    var wireKey = (arduino.localId, arduinoPinId, netId); // Store the Arduino pin and its destination net
                    if (drawnArduinoWires.Contains(wireKey)) continue; //Wire already exists! No need to redraw
                    string? arduinoHoleId = availableHoles.FirstOrDefault(h => !usedHoles.Contains(h) && BreadboardNet.AreConnected(h, holeId)); // Store the first free hole connected to the component hole
                    if (arduinoHoleId == null) continue; // If a free hole is found
                    var (arduinoHoleX, arduinoHoleY) = BreadboardHoleCoordinates.GetCenter(arduinoHoleId); // Find the relative position of available hole to breadboard
                    var arduinoEnd = ZoomCoord((BreadboardX + arduinoHoleX, BreadboardY + arduinoHoleY)); // Calculate the available hole position on workbench
                    lines.Add(new GridLine(
                        wireColor,
                        arduinoStart,
                        arduinoEnd,
                        arduino.localId,
                        -1,
                        $"{arduino.Data.name} {arduinoPin.name} → Breadboard {arduinoHoleId}",
                        []
                    ));
                    RouteWire(routes, arduinoStart.x, arduino.localId, horizonalEnd: true);
                    
                    // Reserve the new hole and record the wire so it won't redraw later
                    usedHoles.Add(arduinoHoleId);
                    drawnArduinoWires.Add(wireKey);
                }

            }
        }
    }
    
    //Make wires route horizontally if they share an X position with another wire
    private void RouteWire(Dictionary<(int, int), (bool, bool)> routes, double x, int id, bool horizonalEnd = false)
    {
        var startX = (int)Math.Floor(x);
        if (routes.ContainsKey((id, startX)))
        {
            routes[(id, startX)] = (true, horizonalEnd);
        }
        else
        {
            routes[(id, startX)] = (false, horizonalEnd);
        }
    }
    
    public double RotateX(int rot, double X, double Y)
    {
        return (3 > rot && rot > 0 ? -1 : 1) * (rot % 2 == 0 ? X : Y);
    }

    public double RotateY(int rot, double X, double Y)
    {
        return (rot > 1 ? -1 : 1) * (rot % 2 == 0 ? Y : X);
    }

    /// <summary>
    /// Populates the segments for a given gridline
    /// </summary>
    /// <param name="line">the line to populate segments of</param>
    /// <param name="offset">the offset of the midpoint line if moving vertically first</param>
    /// <param name="moveHorizontallyFirst">whether to move horizontally or vertically first</param>
    private void GetGridSegments(GridLine line, double offset, (bool, bool) moveHorizontallyAtEndPoints)
    {
        var start = line.Start;
        var end = line.End;

        var currentX = start.x;
        var currentY = start.y;

        if (moveHorizontallyAtEndPoints.Item1)
        {
            var nextX = moveHorizontallyAtEndPoints.Item2 ? (start.x + end.x) / 2 + offset : end.x;
            line.Segments.Add(new Segment(currentX, currentY, nextX, currentY));
            currentX = nextX;

            if (moveHorizontallyAtEndPoints.Item2)
            {
                line.Segments.Add(new Segment(currentX, currentY, currentX, end.y));
                currentY = end.y;
            }
        }
        else
        {
            var nextY = moveHorizontallyAtEndPoints.Item2 ? end.y : (start.y + end.y) / 2 + offset;
            line.Segments.Add(new Segment(currentX, currentY, currentX, nextY));
            currentY = nextY;

            if (!moveHorizontallyAtEndPoints.Item2)
            {
                line.Segments.Add(new Segment(currentX, currentY, end.x, currentY));
                currentX = end.x;
            }
        }
        line.Segments.Add(new Segment(currentX, currentY, end.x, end.y));
    }

    /// <summary>
    /// Currently unused. Sets the component back to center.
    /// </summary>
    private void CenterView()
    {
        if (comps.Count == 0) return;
        
        var minX = comps.Values.Min(c => c.X);
        var minY = comps.Values.Min(c => c.Y);
        
        var maxX = comps.Values.Max(c => c.X);
        var maxY = comps.Values.Max(c => c.Y);
        
        var centerX = (minX + maxX) / 2;
        var centerY = (minY + maxY) / 2;
        
        transform.translate.x = 1920/2 - centerX * zoomFactor;
        transform.translate.y = 1080/2 - centerY * zoomFactor;
    }

    /// <summary>
    /// Handles scrollwheel zooming.
    /// </summary>
    /// <param name="e">Provided scrollwheel event.</param>
    private void UpdZoom(WheelEventArgs e)
    {
        var delta = e.DeltaY / -1000;
        SetZoom(zoomFactor + delta, e.ClientX, e.ClientY);

    }
    
    /*
     * helper function for updzoom
     */
    private void SetZoom(double newZoom, double centerX, double centerY)
    {
        var oldZoom = zoomFactor;
        zoomFactor = Math.Clamp(newZoom, 0.4, 3);
        if (oldZoom == zoomFactor) return;
        var scale = zoomFactor / oldZoom;
        transform.translate.x = centerX - scale * (centerX - transform.translate.x);
        transform.translate.y = centerY - scale * (centerY - transform.translate.y);
        AdjustZoom();
    }
    
    /*
     * related zoom function
     */
    private void ZoomIn()
    {
        SetZoom(zoomFactor + 0.1, 1920 / 2, 1080 / 2);
    }

    /*
     * related zoom function
     */
    private void ZoomOut()
    {
        SetZoom(zoomFactor - 0.1, 1920 / 2, 1080 / 2);
    }
    
    /*
     * related zoom function
     */
    private int ZoomPercent => (int)Math.Round(zoomFactor * 100);
    
    /*
     * related zoom function
     */
    private void ResetZoom()
    {
        SetZoom(1, 1920 / 2, 1080 / 2);
    }

    public void AdjustZoom()
    {
        foreach (var comp in comps.Values)
        {
            AdjustCompToZoom(comp);
        }
        AdjustBBToZoom();
    }
    
    /// <summary>
    /// Attempts to scale a component in place to account for zoom.
    /// </summary>
    /// <param name="comp">Component to adjust.</param>
    /// <returns>the component, now adjusted.</returns>
    private void AdjustCompToZoom(ComponentInstance comp)
    {
        var coord = (x: comp.X, y: comp.Y);

        var z = ZoomCoord(coord);

        comp.zoomedX = z.x;
        comp.zoomedY = z.y;
    }

    public double BreadboardX = 0;
    public double BreadboardY = 0;
    public double BreadboardZoomX;
    public double BreadboardZoomY; 
    private void AdjustBBToZoom()
    {
        
        var z = ZoomCoord((BreadboardX, BreadboardY));
        BreadboardZoomX = z.x;
        BreadboardZoomY = z.y;
    }
    

    /// <summary>
    /// Atteampts to calculate the total effect of zoom on a coordinate.
    /// </summary>
    /// <param name="coord">a coordinate to zoom</param>
    /// <returns>the zoomed coordinate.</returns>
    private (double x, double y) ZoomCoord((double x, double y) coord)
    {
        coord.x = coord.x *  zoomFactor + transform.translate.x;
        coord.y = coord.y *  zoomFactor + transform.translate.y;

        return coord;
    }

    /// <summary>
    /// Attempts to reverse the effects of zoom on a zoomed component.
    /// </summary>
    /// <param name="comp">the component in question.</param>
    /// <returns>the component, now returned to normal.</returns>
    public ComponentInstance UnZoom(ComponentInstance comp)
    {
        comp.X = (comp.X - transform.translate.x) / zoomFactor;
        comp.Y = (comp.Y - transform.translate.y) / zoomFactor;
        
        return comp;
    }


    //handle the start of drags that target a specific component
    private void DragComponentStart(MouseEventArgs e, KeyValuePair<int, ComponentInstance> target)
    {
        if (e.Button != 0) return;
        _dragging = true; //start drag, signal that there is a selected component, and remember it
        _hasTarget = true;
        this._target = target;
    }

    
    //Handle the start of dragging the breadboard
    private void DragBreadboardStart(MouseEventArgs e)
    {
        if (e.Button != 0) return;
        _dragging = true; //start drag, signal that there is a selected component, and remember it
        _breadboardDrag = true;
    }
    
    //generic continuous drag, whether or not there is a component.
    private void DragMiddle(MouseEventArgs e)
    {
        foreach (var component in _componentReferences.Values)
        {
            component.HandleCanvasMouseMove(e);
        }

        switch (_dragging)
        {
            //dragging a specific component, the target
            case true when _hasTarget:
                _target.Value.X += (e.MovementX / zoomFactor);
                _target.Value.Y += (e.MovementY / zoomFactor);
                AdjustCompToZoom(_target.Value);
                break;
            //dragging the canvas, all components
            case true when _breadboardDrag:
                BreadboardX += (e.MovementX / zoomFactor);
                BreadboardY += (e.MovementY / zoomFactor);
                AdjustBBToZoom();
                break;
            case true:
            {
                transform.translate.x += e.MovementX;
                transform.translate.y += e.MovementY;
                AdjustZoom();

                break;
            }
        }
    }


    bool dragEndFlag = false; //disable deselection at end of drag

    //handles the end of a drag targeting a specific component, removing the target
    private void DragComponentEnd(MouseEventArgs e)
    {
        _dragging = false;
        _hasTarget = false;
        dragEndFlag = true;
        _breadboardDrag = false;
    }

    //canvas drag start, signal that there is a drag.
    private void DragStart(MouseEventArgs e)
    {
        if (e.Button == 0)
        {
            _dragging = true;
        }
    }

    //canvas drag end, stop drag
    private void DragEnd(MouseEventArgs e)
    {
        _dragging = false;
        foreach (var component in _componentReferences.Values)
        {
            component.EndEnvSettingsDrag();
        }
    }

    bool targetFound = false;

    //click on a component handler. 
    public void ComponentSelection(MouseEventArgs e, KeyValuePair<int, ComponentInstance> c)
    {
        targetFound = true;
        if (Pages.Index.App!.SelectedComponent < 0) //no previous selection
        {
            Pages.Index.App.SelectedComponent = c.Key;
        }
        else if (Pages.Index.App.SelectedComponent != c.Key) //selection is not the previously selected component. Could be || with prev, readability.
        {
            Pages.Index.App.SelectedComponent = c.Key;
        }
        else if (dragEndFlag) //avoid deselects at the end of drags
        {
            dragEndFlag = false;
            Pages.Index.App.SelectedComponent = c.Key;
        }
        else //catch weird stuff with deselect
        {
            Pages.Index.App.SelectedComponent = -1;
        }
    }

    public void BreadboardSelection()
    {
        targetFound = true;
        Pages.Index.App.SelectedComponent = -3;
    }
    
    //click on the canvas handler.
    private void CanvasClick()
    {
        if (!targetFound)
        {
            Pages.Index.App!.SelectedComponent = -2;
        }

        targetFound = false;
    }

    public void TriggerRefresh()
    {
        StateHasChanged();
        AdjustZoom();

        ConnLines.Clear(); // Remove all wires
        foreach (var comp in comps.Values)
        {
            foreach (var connMap in comp.ConnMap)
            {
                foreach (var conn in connMap.Value)
                {
                    ConnLines.Add(conn); // Rebuild wires with correct positions
                }
            }
        }
    }

}