@inherits RazorComponent

@code {
    
    [Parameter]
    [ValueSetting("µg/m³", 15, 0, 500)]
    public double dustDensity { get; set; }

    public static ElementPin[] pinInfo
    {
        get
        {
            return new ElementPin[]
            {
                new ElementPin(name: "Vcc", x: 148, y: 289, signals: new PinSignalInfo[] { }, number: 1),
                new ElementPin(name: "gnd", x: 116.5, y: 289, signals: new PinSignalInfo[] { }, number: 4),
                new ElementPin(name: "led", x: 127, y: 289, signals: new PinSignalInfo[] { }, number: 5),
                new ElementPin(name: "vout", x: 137.5, y: 289, signals: new PinSignalInfo[] { }, number: 6)
            };
        }
    }
}

