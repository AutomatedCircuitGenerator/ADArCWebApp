@using ADArCWebApp.Shared.EnvironmentalSettings
@inherits RazorComponent

@attribute [Component("PIR Motion", "Input/Other Sensors", "hcsr501", true, 1, 75, 75, paneHoverText: "HC-SR501")]
@attribute [ComponentCode(CodeType.LoopMain, "  val@ = digitalRead(inputPin@); // read input value\n  if (val@ == HIGH) { // check if the input is HIGH\n    if (pirState@ == LOW) {\n      // we have just turned on\n      Serial.println(\"Motion detected!\");\n      // We only want to print on the output change, not state\n      pirState@ = HIGH;\n    }\n  } else {\n    if (pirState@ == HIGH) {\n      // we have just turned of\n      Serial.println(\"Motion ended!\");\n      // We only want to print on the output change, not state\n      pirState@ = LOW;\n    }\n  }")]
@attribute [ComponentCode(CodeType.Global, "int inputPin@ = ~\"digital_out\"; // choose the input pin (for PIR sensor)\nint pirState@ = LOW; // we start, assuming no motion detected\nint val@ = 0; // variable for reading the pin status")]
@attribute [ComponentCode(CodeType.Setup, "  pinMode(inputPin@, INPUT); // declare sensor as input")]


@attribute [ComponentPin("gnd", "gnd",73, 105, number: 1)]
@attribute [ComponentPin("digital_out", "digital_out", 82, 105, number: 2)]
@attribute [ComponentPin("5V", "5V", 91, 105, number: 3)]

@attribute [ComponentProperty("triggermode", 0.0, typeof(double))]
@attribute [ComponentProperty("timedelayseconds", 1.0, typeof(double))]
@attribute [ComponentProperty("ismotiondetected", 1.0, typeof(double))]

@attribute [ComponentEnviormentSettingsType(typeof(PIRButton))]

@code {
    //reset timer if new motion detected
    // default is no retrigger
    [Parameter]
    [ValueSetting("", 0, 0, 1)]
    public double triggermode
    {
        get;
        set;
    }

    //how long to hold the pin high in seconds
    [Parameter]
    [ValueSetting("S", 1, 1, 180)]
    public double timedelayseconds
    {
        get;
        set;
    }

    [Parameter]
    public double ismotiondetected
    {
        get;
        set;
    }

}

