@inherits RazorComponent

@code {
    [Parameter]
    [DropdownSetting(["red", "blue", "green", "yellow", "purple", "orange", "white"])]
    public string color
    {
        get;
        set;
    }


    public static ElementPin[] pinInfo
    {
        get
        {
            return new ElementPin[]
            {
                new ElementPin(name: "sig", x: 50, y: 66, signals: new PinSignalInfo[] { }, description: "Anode"),
                new ElementPin(name: "gnd", x: 39, y: 66, signals: new PinSignalInfo[] { }, description: "Cathode")
            };
        }
    }

}

<div class="led-container">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 760" width="100" height="380">
  <defs>
  <!-- Soft highlight used on the resistor body -->
  <linearGradient
    id="lr_resistorHighlight"
    x1="0" y1="0"
    x2="1" y2="0">
    <stop offset="0%"   stop-color="#323232" stop-opacity="0.20" />
    <stop offset="50%"  stop-color="#ffffff" stop-opacity="0.40" />
    <stop offset="100%" stop-color="#323232" stop-opacity="0.15" />
  </linearGradient>

  <!-- LED glow filters -->
  <filter id="lr_ledGlowSmall" x="-120%" y="-120%" width="340%" height="340%">
    <feGaussianBlur stdDeviation="2" />
  </filter>

  <filter id="lr_ledGlowLarge" x="-48%" y="-48%" width="196%" height="196%">
    <feGaussianBlur stdDeviation="4" />
  </filter>

  <!-- Resistor body shape reused for clipping/highlight -->
  <path
    id="lr_resistorBodyShape"
    d="M 4.69,0
       C 3.63,0 2.77,0.67 2.77,1.50
       C 2.77,2.33 3.63,3.00 4.69,3.00
       C 5.12,3.00 5.51,2.89 5.82,2.71
       L 9.92,2.71
       C 10.24,2.89 10.63,3.00 11.05,3.00
       C 12.11,3.00 12.97,2.33 12.97,1.50
       C 12.97,0.67 12.11,0.00 11.05,0.00
       C 10.63,0.00 10.24,0.11 9.92,0.29
       L 5.82,0.29
       C 5.51,0.11 5.12,0.00 4.69,0.00 Z" />

  <clipPath id="lr_resistorBodyClip">
    <use href="#lr_resistorBodyShape" />
  </clipPath>
</defs>

<!-- Move/scale the whole component with this transform -->
<g id="led_resistor_component" transform="translate(23.85 76) scale(3.7)">
  <!-- ======================== LED ======================== -->
  <g id="led_component">

    <!-- LED metal leads -->
    <rect
      x="17.339" y="29.588"
      width="2.1514" height="9.8273"
      fill="#8c8c8c" />

    <path
      d="M 27.807,39.475
         C 27.807,38.301 26.939,36.962 25.915,36.073
         C 25.499,35.706 24.716,35.072 24.716,34.648
         L 24.716,29.177
         L 22.555,29.177
         L 22.555,34.957
         C 22.555,36.016 23.503,36.836 24.501,37.705
         C 24.946,38.081 25.849,38.955 25.849,39.475 Z"
      fill="#8c8c8c" />

    <!-- Dark rear shadow of LED shell -->
    <path
      d="M 29.003,22.207
         L 29.003,16.294
         C 29.003,12.381 25.835,9.206 21.918,9.206
         C 18.005,9.206 14.830,12.375 14.830,16.294
         L 14.830,29.943
         C 16.304,31.594 18.927,32.696 21.918,32.696
         C 26.538,32.696 30.286,30.078 30.286,26.837
         L 30.286,25.314
         C 30.285,24.171 29.812,23.109 29.003,22.207 Z"
      fill="#000000"
      opacity="0.30" />

    <!-- Translucent LED shell -->
    <path
      d="M 29.003,22.207
         L 29.003,16.294
         C 29.003,12.381 25.835,9.206 21.918,9.206
         C 18.005,9.206 14.830,12.375 14.830,16.294
         L 14.830,29.943
         C 16.304,31.594 18.927,32.696 21.918,32.696
         C 26.538,32.696 30.286,30.078 30.286,26.837
         L 30.286,25.314
         C 30.285,24.171 29.812,23.109 29.003,22.207 Z"
      fill="#e6e6e6"
      opacity="0.50" />

    <!-- Lower/base shading -->
    <path
      d="M 29.003,22.207
         L 29.003,25.312
         C 29.003,28.051 25.837,30.278 21.918,30.278
         C 18.005,30.278 14.830,28.059 14.830,25.312
         L 14.830,29.942
         C 16.304,31.594 18.927,32.695 21.918,32.695
         C 26.538,32.695 30.286,30.077 30.286,26.837
         L 30.286,25.313
         C 30.285,24.171 29.812,23.109 29.003,22.207 Z"
      fill="#d1d1d1"
      opacity="0.90" />

    <!-- Internal lower shadow -->
    <g transform="translate(14.83 9.2059)">
      <path
        d="M 14.173,13.001
           L 14.173,16.106
           C 14.173,18.845 11.007,21.072 7.088,21.072
           C 3.176,21.072 0,18.853 0,16.106
           L 0,20.736
           C 1.474,22.388 4.097,23.489 7.088,23.489
           C 11.707,23.489 15.456,20.871 15.456,17.630
           L 15.456,16.107
           C 15.455,14.965 14.982,13.903 14.173,13.001 Z"
        fill="#000000"
        opacity="0.70" />

      <ellipse
        cx="7.0877" cy="16.106"
        rx="7.087" ry="4.9608"
        fill="#000000"
        opacity="0.25" />
    </g>

    <!-- Internal LED electrodes -->
    <polygon
      points="24.842,18.011 18.237,18.011 17.033,18.854 17.033,25.313 18.026,25.313 18.026,22.301 20.846,22.301"
      fill="#666666" />

    <polygon
      points="26.804,25.313 26.804,17.730 25.608,17.730 26.045,18.240 22.242,22.301 25.890,22.301 25.890,25.313"
      fill="#666666" />

    <!-- LED red color layer, change fill to change color of LED -->
    <path
      d="M 29.003,22.207
         L 29.003,16.294
         C 29.003,12.381 25.835,9.206 21.918,9.206
         C 18.005,9.206 14.830,12.375 14.830,16.294
         L 14.830,29.943
         C 16.304,31.594 18.927,32.696 21.918,32.696
         C 26.538,32.696 30.286,30.078 30.286,26.837
         L 30.286,25.314
         C 30.285,24.171 29.812,23.109 29.003,22.207 Z"
      fill="#ff2b2b"
      opacity="0.65" />

    <!-- White surface highlights -->
    <g transform="translate(14.83 9.2059)" fill="#ffffff" opacity="0.50">
      <path
        d="M 10.388,3.754
           L 11.824,3.481
           C 10.982,2.349 9.742,1.523 8.283,1.242
           L 8.537,2.323
           C 9.301,2.594 9.944,3.103 10.388,3.754 Z" />

      <path
        d="M 0.768,19.926
           L 0.768,21.446
           C 1.417,21.975 2.202,22.422 3.076,22.763
           L 3.076,21.238
           C 2.198,20.901 1.419,20.456 0.768,19.926 Z" />
    <!-- Glowing effect when turn on-->
    <g id ="ledOn">
    <circle
      cx="7" cy="11" r="10"
      fill="#ff7777"
      opacity="0.95"
      filter="url(#lr_ledGlowLarge)" />

    <circle
      cx="7" cy="11" r="2.5"
      fill="#ffffff"
      opacity="0.95"
      filter="url(#lr_ledGlowSmall)" />
    </g>
  </g>

  <!-- ===================== RESISTOR ===================== -->
  <!-- A matrix transform uses: x' = ax + cy + e and y' = bx + dy + f -->
<!-- When a = 0 and d = 0, the object is rotated 90°. The b and c values control the rotation/scale, while e and f control the x and y position. -->
  <g id="resistor_1k" transform="matrix(0 -2.3 3 0 22.3 100)">

    <!-- Metal lead -->
    <rect
      x="0" y="1.1759"
      width="15.558" height="0.63826"
      fill="#aaaaaa" />

    <!-- Beige resistor body -->
    <use
      href="#lr_resistorBodyShape"
      fill="#d5b597" />

    <!-- Soft body highlight -->
    <use
      href="#lr_resistorBodyShape"
      fill="url(#lr_resistorHighlight)"
      opacity="0.45" />

    <!-- 1 kΩ bands: brown, black, red, gold -->
    <rect
      x="4.0" y="0"
      width="1.0" height="3.0"
      fill="#8f4814"
      clip-path="url(#lr_resistorBodyClip)" />

    <rect
      x="6.0" y="0.294"
      width="0.96" height="2.412"
      fill="#000000" />

    <rect
      x="7.8" y="0.294"
      width="0.96" height="2.412"
      fill="#d32f2f" />

    <rect
      x="10.69" y="0"
      width="1.0" height="3.0"
      fill="#f1d863"
      clip-path="url(#lr_resistorBodyClip)" />
  </g>
  <path d="M 18.46 64.2 V 159.6" stroke="#000000" stroke-width="2.25"/>
  <path d="M 26.83 133.35 V 167.7" stroke="#ff0000" stroke-width="2.25"/>
  </g>
</g>

</svg>
</div>