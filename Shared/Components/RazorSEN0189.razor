    <rect x="1100" y="915" width="225" height="215" class="silk"/>
    <circle cx="1215" cy="1025" r="42" class="silk"/>
    <path d="M1215 990 V1060 M1180 1025 H1250" class="silk"/>
    <circle cx="1130" cy="1030" r="20" class="gold"/>
    <circle cx="1300" cy="1030" r="20" class="gold"/>
    <circle cx="1215" cy="1100" r="20" class="gold"/>
  </g>

  <!-- ==================== LOWER SYMBOLS ==================== -->
  <g id="lower-symbols" class="label">
    <text x="1600" y="980" font-size="58">D</text>
    <text x="1600" y="1045" font-size="58">&amp;</text>
    <text x="1600" y="1110" font-size="58">A</text>
  </g>

  <!-- ==================== SMALL INDICATOR DOTS ==================== -->
  <g id="indicator-dots" class="gold">
    <circle cx="1350" cy="466" r="9"/>
    <circle cx="1030" cy="1085" r="24"/>
    <circle cx="1700" cy="263" r="9" fill="#f5cf63"/>
  </g>

  <!-- ==================== CONNECTING GREY WIRES ==================== -->
  <g id="connecting-wires">
    <!-- Wire 1 -->
    <path d="M 360 500 V 610 H 700" class="wire-outer"/> 

    <!-- Wire 2 -->
    <path d="M 280 500 V 690 H 700" class="wire-outer"/> 

    <!-- Wire 3 -->
    <path d="M 200 500 V 770 H 700" class="wire-outer"/> 
  </g>

  <!-- ==================== ENLARGED BLUE SENSOR (ON THE LEFT) ==================== -->
  <g id="turbidity-sensor-head" transform="translate(0 0) scale(1.4)">
    <!-- Glass Housing -->
    <g id="glass-housing" transform="translate(200 200)">
      <path d="M-102 150V88c0 -16 10 -28 24 -30V25C-78 10 -65 0 -50 0s26 10 26 25V80h48V25C24 10 35 0 50 0s28 10 28 25V58c14 2 24 14 24 30v62Z" class="sensor-housing-fill sensor-housing-stroke"/>
      <path d="M-24 80V35C-24 28 -18 22 -10 22H10c8 0 14 6 14 13V80" fill="none" stroke="#64748b" stroke-width="2.5"/>
      <path d="M-98 92h196" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/>
