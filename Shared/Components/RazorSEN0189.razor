    <!-- left resistor bank -->
    <g class="resistor">
      <rect x="1170" y="570" width="100" height="38" rx="8"/>
      <rect x="1170" y="635" width="100" height="38" rx="8"/>
      <rect x="1170" y="700" width="100" height="38" rx="8"/>
      <rect x="1170" y="765" width="100" height="38" rx="8"/>
      <rect x="1170" y="830" width="100" height="38" rx="8"/>
    </g>

    <!-- chip pins -->
    <g class="gold">
      <rect x="1320" y="555" width="28" height="62" rx="12"/>
      <rect x="1358" y="555" width="28" height="62" rx="12"/>
      <rect x="1396" y="555" width="28" height="62" rx="12"/>
      <rect x="1434" y="555" width="28" height="62" rx="12"/>
      <rect x="1320" y="755" width="28" height="62" rx="12"/>
      <rect x="1358" y="755" width="28" height="62" rx="12"/>
      <rect x="1396" y="755" width="28" height="62" rx="12"/>
      <rect x="1434" y="755" width="28" height="62" rx="12"/>
    </g>

    <rect x="1300" y="610" width="185" height="145" rx="8" class="chip"/>
    <circle cx="1325" cy="728" r="10" fill="#202324"/>

    <!-- right components -->
    <g class="resistor">
      <rect x="1520" y="530" width="100" height="38" rx="8"/>
      <rect x="1520" y="775" width="100" height="38" rx="8"/>
    </g>
    <g class="gold">
      <rect x="1520" y="605" width="55" height="38"/>
      <rect x="1590" y="605" width="55" height="38"/>
      <rect x="1520" y="675" width="55" height="38"/>
      <rect x="1590" y="675" width="55" height="38"/>
    </g>
    <text x="1505" y="522" class="label" font-size="42">PWR</text>
    <text x="1620" y="810" class="label" font-size="42">Dout</text>

    <!-- lower component pairs -->
    <g class="gold">
      <rect x="1305" y="845" width="55" height="38"/>
      <rect x="1375" y="845" width="55" height="38"/>
      <rect x="1455" y="845" width="55" height="38"/>
      <rect x="1525" y="845" width="55" height="38"/>
    </g>
  </g>

  <!-- ==================== RIGHT CONNECTOR ==================== -->
  <g id="right-connector">
    <path d="M1800 510 H1970 V880 H1800 V830 H1860 V780 H1800 V730 H1860 V680 H1800 V630 H1860 V580 H1800 Z" class="connector"/>
    <g class="gold">
      <rect x="1750" y="580" width="145" height="50"/>
      <rect x="1750" y="680" width="145" height="50"/>
      <rect x="1750" y="780" width="145" height="50"/>
