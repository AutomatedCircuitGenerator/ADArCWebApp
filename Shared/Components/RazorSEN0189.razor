    <!-- Blue Holder Shell -->
    <g id="blue-holder" transform="translate(200 200)">
      <path d="M-125 75h19V128h18v17h26V156h22v-11h24V156H16v-11h24V156h22v-11h26V128h18V75h19c3 0 5 2 5 5v95c0 7 -6 13 -14 13H-116c-8 0 -14 -6 -14 -13V80c0 -3 2 -5 5 -5Z" class="sensor-holder-fill sensor-holder-stroke"/>
      <path d="M-130 80c0 -5 5 -8 10 -8h10c5 0 8 3 8 8v60h-28Z" class="sensor-clip-fill sensor-clip-stroke"/>
      <path d="M102 80c0 -5 3 -8 8 -8h10c5 0 10 3 10 8v60H102Z" class="sensor-clip-fill sensor-clip-stroke"/>
      <path d="M-128 76h24" stroke="#93c5fd" stroke-width="2" stroke-linecap="round"/>
      <path d="M104 76h24" stroke="#93c5fd" stroke-width="2" stroke-linecap="round"/>
      <path d="M-100 130H100" stroke="#60a5fa" stroke-width="2"/>
    </g>

    <!-- Scaled Terminals from the attached image (dark block + metallic pins) -->
    <g id="metallic-pins-block" transform="translate(150 355) rotate(90)">
      <!-- metallic pins aligned Precisely to grey wire attachment Y-coordinates -->
      <g id="metallic-pin-1">
        <path class="pin-metallic" d="M12 18h20a2 2 0 0 0 2 -2v-20a2 2 0 0 0 -2 -2H12a2 2 0 0 0 -2 2v20a2 2 0 0 0 2 2z"/>
        <circle class="pin-detail-metallic" cx="22" cy="7" r="3.5"/>
      </g>
      <g id="metallic-pin-2">
        <path class="pin-metallic" d="M12 -39h20a2 2 0 0 0 2 -2v-20a2 2 0 0 0 -2 -2H12a2 2 0 0 0 -2 2v20a2 2 0 0 0 2 2z"/>
        <circle class="pin-detail-metallic" cx="22" cy="-50" r="3.5"/>
      </g>
      <g id="metallic-pin-3">
        <path class="pin-metallic" d="M12 -96h20a2 2 0 0 0 2 -2v-20a2 2 0 0 0 -2 -2H12a2 2 0 0 0 -2 2v20a2 2 0 0 0 2 2z"/>
        <circle class="pin-detail-metallic" cx="22" cy="-107" r="3.5"/>
      </g>
    </g>
  </g>
</svg>


