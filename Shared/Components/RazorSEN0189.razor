@inherits RazorComponent

@code {

  public static ElementPin[] pinInfo
  {
    get
    {
      return new ElementPin[]
      {
        new ElementPin(name: "5V", x: 320, y: 128, signals: new PinSignalInfo[] { }, number: 1),
        new ElementPin(name: "gnd", x: 320, y: 143.5, signals: new PinSignalInfo[] { }, number: 2),
        new ElementPin(name: "analog_out", x: 320, y: 158.5, signals: new PinSignalInfo[] { }, number: 3),

      };
    }
  }

  [Parameter]
  [ValueSetting("NTU", 0, 0, 3000)]
  public double turbidity
  {
    get;
    set;
  }
}

<svg xmlns="http://www.w3.org/2000/svg"
     width="375" height="250" viewBox="0 0 2400 1500">

  <title>DFrobot Turbidity PCB with Bottom-Mount Terminals</title>
  <defs>
    <style>
      .board { fill:#151918; stroke:#050606; stroke-width:18; }
      .gold { fill:#e5b84f; stroke:#080909; stroke-width:8; }
      .pad  { fill:#f7f6ef; stroke:#080909; stroke-width:5; }
      .silk { fill:none; stroke:#f3eee0; stroke-width:6; }
      .text { font-family:Arial,Helvetica,sans-serif; fill:#f0c65a; font-weight:700; }
      .label { font-family:Arial,Helvetica,sans-serif; fill:#f3eee0; font-weight:700; }
      .metal { fill:#c9c7bf; stroke:#080909; stroke-width:6; }
      .resistor { fill:#a87952; stroke:#080909; stroke-width:7; }
      .connector { fill:#eee9d9; stroke:#080909; stroke-width:8; }
      .chip { fill:#363a3b; stroke:#080909; stroke-width:8; }
      .wire-outer { fill:none; stroke-linecap:round; stroke-linejoin:round; stroke-width:14; stroke:#475569; }
      .wire-inner { fill:none; stroke-linecap:round; stroke-linejoin:round; stroke-width:6; stroke:#94a3b8; }
      /* Style for new metallic terminals from attached image */
      .pin-metallic { fill:#e2e8f0; stroke:#64748b; stroke-width:3; }
      .pin-detail-metallic { fill:#64748b; }
      .sensor-housing-fill { fill:#e2e8f0; fill-opacity:0.65; }
      .sensor-housing-stroke { stroke:#94a3b8; stroke-width:3; stroke-linejoin:round; fill:none; }
      .sensor-holder-fill { fill:#2563eb; }
      .sensor-holder-stroke { stroke:#1d4ed8; stroke-width:2; }
      .sensor-clip-fill { fill:#3b82f6; }
      .sensor-clip-stroke { stroke:#1d4ed8; stroke-width:1.5; }
    </style>
  </defs>

  <!-- ==================== PCB BODY ==================== -->
  <rect x="725" y="200" width="1254" height="944" rx="125" class="board"/>

  <!-- ==================== MOUNTING HOLES ==================== -->
  <g id="mounting-holes">
    <g transform="translate(855 330)">
      <circle r="108" class="gold"/>
      <circle r="58" fill="#151918" stroke="#080909" stroke-width="6"/>
      <circle cx="-55" cy="-55" r="12" class="pad"/><circle cx="0" cy="-78" r="12" class="pad"/>
      <circle cx="55" cy="-55" r="12" class="pad"/><circle cx="78" cy="0" r="12" class="pad"/>
      <circle cx="55" cy="55" r="12" class="pad"/><circle cx="0" cy="78" r="12" class="pad"/>
      <circle cx="-55" cy="55" r="12" class="pad"/><circle cx="-78" cy="0" r="12" class="pad"/>
    </g>
    <g transform="translate(1848 330)">
      <circle r="108" class="gold"/>
      <circle r="58" fill="#151918" stroke="#080909" stroke-width="6"/>
      <circle cx="-55" cy="-55" r="12" class="pad"/><circle cx="0" cy="-78" r="12" class="pad"/>
      <circle cx="55" cy="-55" r="12" class="pad"/><circle cx="78" cy="0" r="12" class="pad"/>
      <circle cx="55" cy="55" r="12" class="pad"/><circle cx="0" cy="78" r="12" class="pad"/>
      <circle cx="-55" cy="55" r="12" class="pad"/><circle cx="-78" cy="0" r="12" class="pad"/>
    </g>
    <g transform="translate(855 1014)">
      <circle r="108" class="gold"/>
      <circle r="58" fill="#151918" stroke="#080909" stroke-width="6"/>
      <circle cx="-55" cy="-55" r="12" class="pad"/><circle cx="0" cy="-78" r="12" class="pad"/>
      <circle cx="55" cy="-55" r="12" class="pad"/><circle cx="78" cy="0" r="12" class="pad"/>
      <circle cx="55" cy="55" r="12" class="pad"/><circle cx="0" cy="78" r="12" class="pad"/>
      <circle cx="-55" cy="55" r="12" class="pad"/><circle cx="-78" cy="0" r="12" class="pad"/>
    </g>
    <g transform="translate(1848 1014)">
      <circle r="108" class="gold"/>
      <circle r="58" fill="#151918" stroke="#080909" stroke-width="6"/>
      <circle cx="-55" cy="-55" r="12" class="pad"/><circle cx="0" cy="-78" r="12" class="pad"/>
      <circle cx="55" cy="-55" r="12" class="pad"/><circle cx="78" cy="0" r="12" class="pad"/>
      <circle cx="55" cy="55" r="12" class="pad"/><circle cx="0" cy="78" r="12" class="pad"/>
      <circle cx="-55" cy="55" r="12" class="pad"/><circle cx="-78" cy="0" r="12" class="pad"/>
    </g>
  </g>

  <!-- ==================== SILKSCREEN / TOP LABEL ==================== -->
  <g id="top-label">
    <text x="1100" y="262" class="text" font-size="58">D ↔ A</text>
    <text x="1370" y="262" class="text" font-size="56">DFRobot</text>
    <circle cx="1700" cy="263" r="30" class="gold"/>
    <text x="1370" y="318" class="text" font-size="42">Turbidity sensor</text>
    <text x="1645" y="370" class="text" font-size="38">V1.0</text>
  </g>

  <!-- ==================== MODE / SELECTION PADS ==================== -->
  <g id="mode-pads">
    <rect x="1065" y="295" width="295" height="110" class="silk"/>
    <g class="gold">
      <circle cx="1130" cy="300" r="27"/><circle cx="1210" cy="300" r="27"/>
      <circle cx="1290" cy="300" r="27"/>
      <circle cx="1130" cy="405" r="27"/><circle cx="1210" cy="405" r="27"/>
      <circle cx="1290" cy="405" r="27"/>
    </g>
    <g class="pad">
      <circle cx="1130" cy="300" r="11"/><circle cx="1210" cy="300" r="11"/>
      <circle cx="1290" cy="300" r="11"/>
      <circle cx="1130" cy="405" r="11"/><circle cx="1210" cy="405" r="11"/>
      <circle cx="1290" cy="405" r="11"/>
    </g>
  </g>

  <!-- ==================== LEFT TERMINAL BLOCK AREA ==================== -->
  <g id="left-electrodes">
    <path d="M730 550 H1120 V585 H1035 V860 H1120 V880 H730 Z" class="silk"/>
    <g class="metal">
      <rect x="700" y="600" width="160" height="22" rx="10"/>
      <rect x="700" y="680" width="160" height="22" rx="10"/>
      <rect x="700" y="760" width="160" height="22" rx="10"/>
